# Copy to backend/.env for local development. Never commit the real .env.
SOLAR_ENVIRONMENT=development
SOLAR_APP_NAME=Solar Lanka API
# Used when database connections are introduced. Use the root .env development password.
# URL-encode special characters in the password. Do not put test credentials here.
SOLAR_DATABASE_URL=postgresql://solarlanka_dev:replace_with_development_password@127.0.0.1:5432/solarlanka_dev

# Clerk verification (required before using protected routes).
# Set the exact instance issuer and JSON array of frontend origins.
# SOLAR_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# SOLAR_CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# SOLAR_CLERK_SECRET_KEY=your-clerk-secret-key
# Alternatively set SOLAR_CLERK_JWT_KEY to the instance PEM public key.
# Rotate a configured public key when Clerk rotates signing keys.
# SOLAR_CLERK_AUDIENCE=your-api-audience

# Clerk Dashboard webhook: POST /webhooks/clerk; subscribe to user.created/updated/deleted.
# SOLAR_CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_endpoint_signing_secret
# SOLAR_CLERK_INSTANCE_ID=ins_your_instance

# Development/demo account setup (Clerk owns passwords and sessions):
# 1. Use a Clerk development instance; copy its sk_test key, exact issuer,
#    frontend origins and ins_ instance ID into backend/.env using the names above.
#    Uncomment enabled settings. Leave audience unset unless configured in Clerk.
# 2. For Next.js setup, put NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY
#    from that same instance in frontend/.env.local, not this backend file.
# 3. With development PostgreSQL running, from backend/ run:
#    .venv/bin/alembic upgrade head
# 4. Create a demo user in that development instance's Clerk Dashboard, then sign
#    in through Clerk when the frontend is available. Do not seed local passwords,
#    fabricate bearer tokens, or add an authentication bypass for demos.
# 5. Send the Clerk session token as Authorization: Bearer <token> to GET /users/me.
#    First verified access provisions a customer; repeated calls keep the same ID.
#    Roles are local: Clerk metadata and request-supplied roles cannot grant admin.
# 6. Configure a reachable HTTPS webhook URL ending /webhooks/clerk in Clerk,
#    subscribe to user.created/updated/deleted, and copy that endpoint's whsec_
#    signing secret above. A local backend needs a separately started HTTPS tunnel.
#    Confirm delivery in Clerk; provider revocation is eventual until delivery.
#    Suspension/deletion blocks protected access; deletion retains history.
# 7. Automated identity checks need no live Clerk credentials. From backend/ run:
#    .venv/bin/python -m pytest tests/test_auth.py tests/test_account_lifecycle.py
#    With the isolated PostgreSQL test service running, also run:
#    .venv/bin/python -m pytest tests/test_user_provisioning.py tests/test_lifecycle_sync.py --database
# Keep real tokens, keys and demo credentials out of source control and logs.

# ImageKit server integration (only in backend/.env, never NEXT_PUBLIC_*).
# Create a restricted API key with media read/write access in ImageKit.
# SOLAR_IMAGEKIT_PRIVATE_KEY=private_your_key
# SOLAR_IMAGEKIT_PUBLIC_KEY=public_your_key
# SOLAR_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Private documents in local development use backend/storage/private (gitignored).
# This directory is never publicly mounted. Production needs private storage
# with backend-authorised delivery; do not serve this folder as static files.

# Inngest: use the local Dev Server with INNGEST_DEV=1 while developing.
# Production needs both backend-only keys from the Inngest dashboard.
# SOLAR_INNGEST_EVENT_KEY=your-event-key
# SOLAR_INNGEST_SIGNING_KEY=your-signing-key

# Arcjet request protection (backend-only). Unset disables protection in development
# and test with a startup warning; production refuses to start without a key.
# SOLAR_ARCJET_KEY=ajkey_your_site_key
# Provider timeout in milliseconds (100-5000). On timeout or error the request is allowed.
# SOLAR_ARCJET_TIMEOUT_MS=1000
# Addresses/CIDRs of YOUR reverse proxy, so forwarded-IP headers from others are ignored.
# SOLAR_ARCJET_TRUSTED_PROXIES=["10.0.0.0/8"]
# Browser end-to-end runs should leave the key unset: bot detection blocks headless browsers.
