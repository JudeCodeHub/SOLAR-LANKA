# Copy to frontend/.env (or .env.local). Never commit real values.

# Clerk keys from the same Clerk instance as backend/.env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Server-only address of the FastAPI backend. Not exposed to the browser: the browser calls
# this site's /api gateway, which forwards requests here with the session token attached.
API_BASE_URL=http://127.0.0.1:8000
