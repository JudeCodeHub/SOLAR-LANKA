{
  "name": "solarlanka-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "api:types": "tmp=$(mktemp) && (cd ../backend && .venv/bin/python -m app.export_openapi \"$tmp\") && openapi-typescript \"$tmp\" -o src/lib/api/schema.d.ts && rm -f \"$tmp\"",
    "test": "node --test",
    "e2e": "playwright test",
    "design-axe": "playwright test -c playwright.design.config.ts",
    "screens": "playwright test -c playwright.screens.config.ts",
    "photos": "node scripts/photos.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.9",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.18.0"
  }
}
